#include <fstream>
#include <iomanip>
#include <iostream>
#include <sstream>
#include <string>
#include <vector>

using namespace std;

struct Trening {
    string data;
    string nazwa;
    string kategoria;
    int czas;
    int kalorie;
};

string plikNazwa = "historia_treningow.txt";

