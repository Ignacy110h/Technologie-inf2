}

vector<Trening> wczytajZPliku()
{
    vector<Trening> lista;
    ifstream plik(plikNazwa);

    if (!plik.good()) {
        return lista;
    }

    string linia;
    while (getline(plik, linia)) {
        stringstream ss(linia);
        string czasTekst, kalorieTekst;
        Trening t;

        getline(ss, t.data, ';');
        getline(ss, t.nazwa, ';');
        getline(ss, t.kategoria, ';');
        getline(ss, czasTekst, ';');
        getline(ss, kalorieTekst);

        if (t.data != "" && t.nazwa != "" && czasTekst != "" && kalorieTekst != "") {
            t.czas = stoi(czasTekst);
            t.kalorie = stoi(kalorieTekst);
            lista.push_back(t);
        }
    }

    plik.close();
    return lista;
}

void zapiszCalaListe(vector<Trening> lista)
{
    ofstream plik(plikNazwa);

    for (int i = 0; i < lista.size(); i++) {
        plik << lista[i].data << ";";
        plik << lista[i].nazwa << ";";
        plik << lista[i].kategoria << ";";
        plik << lista[i].czas << ";";
        plik << lista[i].kalorie << endl;
    }

    plik.close();
}

string wybierzKategorie()
{
    int wybor;

    cout << "\nKategorie:\n";
    cout << "1. silowy\n";
    cout << "2. cardio\n";
    cout << "3. rozciaganie\n";
    cout << "4. inny\n";

    wybor = wpiszLiczbe("Wybor: ");

    if (wybor == 1) {
        return "silowy";
    } else if (wybor == 2) {
        return "cardio";
    } else if (wybor == 3) {
        return "rozciaganie";
    } else {
        return "inny";
    }
}

void pokazJedenTrening(Trening t, int nr)
{
    cout << setw(4) << nr;
    cout << setw(14) << t.data;
    cout << setw(20) << t.nazwa;
    cout << setw(15) << t.kategoria;
    cout << setw(10) << t.czas;
    cout << setw(10) << t.kalorie << endl;
}

void naglowekTabeli()
{
    cout << setw(4) << "Nr";
    cout << setw(14) << "Data";
    cout << setw(20) << "Nazwa";
    cout << setw(15) << "Kategoria";
    cout << setw(10) << "Minuty";
    cout << setw(10) << "Kalorie" << endl;
    cout << "--------------------------------------------------------------------------\n";
}

void dodajTrening()
{
    Trening t;

    cout << "\nDODAWANIE TRENINGU\n";
    cout << "Data (np. 2026-06-14): ";
    getline(cin, t.data);

    cout << "Nazwa treningu: ";
    getline(cin, t.nazwa);

    t.kategoria = wybierzKategorie();
    t.czas = wpiszLiczbe("Czas w minutach: ");
    t.kalorie = wpiszLiczbe("Spalone kalorie: ");

    ofstream plik(plikNazwa, ios::app);

    if (!plik.good()) {
        cout << "Nie mozna zapisac do pliku.\n";
        return;
    }

    plik << t.data << ";" << t.nazwa << ";" << t.kategoria << ";";
    plik << t.czas << ";" << t.kalorie << endl;
    plik.close();

    cout << "Dodano trening.\n";
}

void pokazHistorie()
{
    vector<Trening> lista = wczytajZPliku();

    cout << "\nHISTORIA TRENINGOW\n";

    if (lista.size() == 0) {
        cout << "Brak zapisanych treningow.\n";
        return;
    }

    naglowekTabeli();

    for (int i = 0; i < lista.size(); i++) {
        pokazJedenTrening(lista[i], i + 1);
    }
}

void usunTrening()
{
    vector<Trening> lista = wczytajZPliku();

    if (lista.size() == 0) {
        cout << "\nNie ma czego usuwac.\n";
        return;
    }

    pokazHistorie();

    int nr = wpiszLiczbe("\nPodaj numer treningu do usuniecia: ");

    if (nr < 1 || nr > lista.size()) {
        cout << "Nie ma takiego numeru.\n";
        return;
    }

    lista.erase(lista.begin() + nr - 1);
    zapiszCalaListe(lista);

    cout << "Usunieto trening.\n";
}

void podsumowanie()
{
    vector<Trening> lista = wczytajZPliku();

    if (lista.size() == 0) {
        cout << "\nBrak danych do podsumowania.\n";
        return;
    }

    int sumaCzas = 0;
    int sumaKalorie = 0;

    for (int i = 0; i < lista.size(); i++) {
        sumaCzas = sumaCzas + lista[i].czas;
        sumaKalorie = sumaKalorie + lista[i].kalorie;
    }

    cout << "\nPODSUMOWANIE\n";
    cout << "Liczba treningow: " << lista.size() << endl;
    cout << "Laczny czas: " << sumaCzas << " minut" << endl;
    cout << "Laczne kalorie: " << sumaKalorie << " kcal" << endl;
    cout << "Sredni czas treningu: " << (double)sumaCzas / lista.size() << " minut" << endl;
    cout << "Srednia liczba kalorii: " << (double)sumaKalorie / lista.size() << " kcal" << endl;
}

void szukajTreningu()
{
    vector<Trening> lista = wczytajZPliku();

    if (lista.size() == 0) {
        cout << "\nBrak treningow w pliku.\n";
        return;
    }

    int wybor;
    string szukane;
    bool znaleziono = false;

    cout << "\nSZUKANIE\n";
    cout << "1. Po dacie\n";
    cout << "2. Po nazwie\n";
    cout << "3. Po kategorii\n";
    wybor = wpiszLiczbe("Wybor: ");

    cout << "Wpisz szukany tekst: ";
    getline(cin, szukane);
    szukane = maleLitery(szukane);

    naglowekTabeli();

    for (int i = 0; i < lista.size(); i++) {
        string tekst;

        if (wybor == 1) {
            tekst = lista[i].data;
        } else if (wybor == 2) {
            tekst = lista[i].nazwa;
        } else {
            tekst = lista[i].kategoria;
        }

        if (maleLitery(tekst).find(szukane) != string::npos) {
            pokazJedenTrening(lista[i], i + 1);
            znaleziono = true;
        }
    }

    if (znaleziono == false) {
        cout << "Brak wynikow.\n";
    }
}

string klasyfikacjaBMI(double bmi)
{
    if (bmi < 18.5) {
        return "niedowaga";
    } else if (bmi < 25) {
        return "waga prawidlowa";
    } else if (bmi < 30) {
        return "nadwaga";
    } else {
        return "otylosc";
    }
}

void bmi()
{
    double waga, wzrost, wynik;

    cout << "\nOBLICZANIE BMI\n";
    waga = wpiszLiczbeDouble("Podaj wage w kg: ");
    wzrost = wpiszLiczbeDouble("Podaj wzrost w cm: ");

    wzrost = wzrost / 100;
    wynik = waga / (wzrost * wzrost);

    cout << fixed << setprecision(2);
    cout << "BMI: " << wynik << endl;
    cout << "Klasyfikacja: " << klasyfikacjaBMI(wynik) << endl;
}

void menu()
{
    cout << "\n===== PLAN TRENINGOWY =====\n";
    cout << "1. Dodaj trening\n";
    cout << "2. Pokaz historie\n";
    cout << "3. Usun trening\n";
    cout << "4. Podsumowanie\n";
    cout << "5. Szukaj treningu\n";
    cout << "6. Oblicz BMI\n";
    cout << "0. Koniec\n";
}

int main()
{
    int wybor;

    do {
        menu();
        wybor = wpiszLiczbe("Wybierz opcje: ");

        if (wybor == 1) {
            dodajTrening();
        } else if (wybor == 2) {
            pokazHistorie();
        } else if (wybor == 3) {
            usunTrening();
        } else if (wybor == 4) {
            podsumowanie();
        } else if (wybor == 5) {
            szukajTreningu();
        } else if (wybor == 6) {
            bmi();
        } else if (wybor == 0) {
            cout << "Koniec programu.\n";
        } else {
            cout << "Nie ma takiej opcji.\n";
        }

    } while (wybor != 0);

    return 0;
}
