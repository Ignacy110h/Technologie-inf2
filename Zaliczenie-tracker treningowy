string maleLitery(string tekst)
{
    for (int i = 0; i < tekst.length(); i++) {
        if (tekst[i] >= 'A' && tekst[i] <= 'Z') {
            tekst[i] = tekst[i] + 32;
        }
    }
    return tekst;
}

int wpiszLiczbe(string tekst)
{
    int liczba;
    cout << tekst;
    cin >> liczba;

    while (cin.fail()) {
        cin.clear();
        cin.ignore(1000, '\n');
        cout << "Blad. Wpisz liczbe: ";
        cin >> liczba;
    }

    cin.ignore(1000, '\n');
    return liczba;
}

double wpiszLiczbeDouble(string tekst)
{
    double liczba;
    cout << tekst;
    cin >> liczba;

    while (cin.fail()) {
        cin.clear();
        cin.ignore(1000, '\n');
